# Datasets — place locally, never commit real data
data/**
!data/README.md

# External baseline clones — place locally, never commit
external/**
!external/README.md

# Checkpoints and model weights
checkpoints/**
*.pt
*.pth
*.ckpt

# Python cache
__pycache__/
*.pyc
*.pyo
.Python
*.egg-info/
dist/
build/

# Results — generated locally, not committed
results/**
!results/README.md
# Paper-referenced artifacts (needed to compile the paper from the repo)
!results/latest/
!results/latest/tables/
!results/latest/figures/
!results/latest/tables/paper_candidate_baseline_comparison_all_datasets_none.tex
